###########################################
# MongoDB Configuration
###########################################

# Admin user for MongoDB initialization
MONGO_INITDB_ROOT_USERNAME=your_mongo_root_user
MONGO_INITDB_ROOT_PASSWORD=your_mongo_root_password
MONGO_INITDB_DATABASE=schoolxr


###########################################
# Server Environment
###########################################

# App mode: dev or production
MODE=dev

# Port the server listens on (exposed as 3001:3001)
PORT=3001

# External service tokens (DO NOT commit real values)
SKETCHFAB_TOKEN=your_sketchfab_token
LTI_KEY=your_lti_key
