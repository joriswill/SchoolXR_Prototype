############################################
# Development Environment only
############################################

# Enables dev-mode: disables LTI and injects fake user
MODE=dev

# Local MongoDB for development (you must run your own local MongoDB)
MONGODB_URI=mongodb://localhost:27017/schoolxr

# Optional development port
PORT=3001

############################################
# External Services (example placeholders)
############################################

# Only needed if your dev features use Sketchfab
SKETCHFAB_TOKEN=your_sketchfab_token_here

# Only needed for production LTI mode (ignored in dev mode)
LTI_KEY=your_lti_key_here
